{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Video Downloader",
  "version": "0.1.0",
  "identifier": "com.junyi.local-video-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Video Downloader",
        "width": 980,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../tools/yt-dlp.exe": "tools/yt-dlp.exe",
      "../tools/ffmpeg/bin/": "tools/ffmpeg/bin/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
